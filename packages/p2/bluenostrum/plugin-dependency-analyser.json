                        "@putenv XDEBUG_MODE=off",
                        "parallel-lint ./src ./composer-dependency-analyser.php"
                    ],
                    "phpcbf": [
                        "@putenv XDEBUG_MODE=off",
                        "php -d memory_limit=2G vendor/bin/phpcbf"
                    ],
                    "phpcs": [
                        "@putenv XDEBUG_MODE=off",
                        "php -d memory_limit=2G vendor/bin/phpcs -s --colors --cache"
                    ],
