                        "@putenv XDEBUG_MODE=off",
                        "phpunit --configuration phpunit.xml.dist --no-coverage"
                    ],
                    "psalm": [
                        "@putenv XDEBUG_MODE=off",
                        "psalm --config psalm.xml"
                    ],
                    "rector": [
