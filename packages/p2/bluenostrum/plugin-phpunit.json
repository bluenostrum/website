                    "reference": "9d0d1e70d97ab025b1b108cdd1dbe42b6a998922",
                    "shasum": ""
                },
                "require": {
                    "composer-plugin-api": "^2.6",
                    "ext-dom": "*",
                    "php": "^8.5.12",
                    "phpunit/phpunit": "^13.4.6"
                },
                "require-dev": {
                    "bluenostrum/plugin-captainhook": "^2.0",
                    "bluenostrum/plugin-dependency-analyser": "^2.0",
                    "bluenostrum/plugin-infection": "^2.0",
                    "bluenostrum/plugin-phpcs": "^2.0",
                    "bluenostrum/plugin-phpstan": "^2.0",
                    "bluenostrum/plugin-psalm": "^1.0",
                    "bluenostrum/plugin-rector": "^2.0",
                    "composer/composer": "^2.10",
                    "php-parallel-lint/php-parallel-lint": "^1.4",
                    "roave/security-advisories": "dev-latest",
                    "symfony/process": "^8.1"
                },
                "time": "2026-11-04T09:15:01+00:00",
                "type": "composer-plugin",
                "extra": {
                    "bluenostrum": {
                        "captainhook": {
                            "verify": [
                                "composer phpunit"
                            ]
                        },
                        "dependency-analyser": {
                            "ignore": [
                                {
                                    "errors": [
                                        "dev-dependency-in-prod"
                                    ],
                                    "packages": [
                                        "composer/composer"
                                    ],
                                    "paths": [
                                        "src/Composer"
                                    ],
                                    "reason": "The plugin runs inside Composer, which provides those classes itself; composer-plugin-api is the requirement, and composer/composer serves the analysis and the tests."
                                },
                                {
                                    "errors": [
                                        "shadow-dependency"
                                    ],
                                    "packages": [
                                        "symfony/console"
                                    ],
                                    "paths": [
                                        "src/Composer"
                                    ],
                                    "reason": "Composer provides symfony/console to a plugin at run time, as it provides its own classes; requiring it would install a copy beside the one Composer runs."
                                },
                                {
                                    "errors": [
                                        "prod-dependency-only-in-dev"
                                    ],
                                    "packages": [
                                        "phpunit/phpunit"
                                    ],
                                    "reason": "The commands run PHPUnit as an executable, so no production code names its classes; the package requires it so a project gets PHPUnit from the package alone."
                                }
                            ]
                        },
                        "plugin": {
                            "settings": "phpunit",
                            "verify": [
                                "phpunit"
                            ]
                        }
                    },
                    "captainhook": {
                        "config": "vendor/bluenostrum/plugin-captainhook/captainhook.json",
                        "force-install": true
                    },
                    "class": "Bluenostrum\\PhpUnit\\Composer\\Plugin"
                },
                "autoload": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "coverage": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php coverage"
                    ],
                    "phpunit": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php phpunit"
                    ]
                },
                "license": [
                    "proprietary"
                ],
                "authors": [
                    {
                        "name": "Antonio del Olmo",
                        "email": "adelolmo@bluenostrum.com"
                    }
                ],
