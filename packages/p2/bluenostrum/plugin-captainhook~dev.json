{
    "packages": {
        "bluenostrum/plugin-captainhook": [
            {
                "name": "bluenostrum/plugin-captainhook",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "git@github.com:bluenostrum/plugin-captainhook.git",
                    "reference": "48ff7225c03ea568440da2c1614c5cbdbb9ea719"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/bluenostrum/plugin-captainhook/zipball/48ff7225c03ea568440da2c1614c5cbdbb9ea719",
                    "reference": "48ff7225c03ea568440da2c1614c5cbdbb9ea719",
                    "shasum": ""
                },
                "require": {
                    "bluenostrum/plugin-composer": "^1.1.0",
                    "captainhook/captainhook-phar": "^5.29.2",
                    "captainhook/plugin-composer": "^5.3.3",
                    "composer-plugin-api": "^2.6",
                    "ergebnis/composer-normalize": "^2.56.1",
                    "php": "^8.5.12",
                    "ramsey/conventional-commits": "^1.7"
                },
                "require-dev": {
                    "bluenostrum/plugin-dependency-analyser": "^2.2.1",
                    "bluenostrum/plugin-infection": "^2.0.1",
                    "bluenostrum/plugin-phpcs": "^2.1.2",
                    "bluenostrum/plugin-phpstan": "^2.5.1",
                    "bluenostrum/plugin-phpunit": "^1.2.0",
                    "bluenostrum/plugin-psalm": "^1.1.2",
                    "bluenostrum/plugin-rector": "^2.2.1",
                    "composer/composer": "^2.11.2",
                    "composer/xdebug-handler": "^3.0.5",
                    "php-parallel-lint/php-parallel-lint": "^1.4",
                    "roave/security-advisories": "dev-latest",
                    "symfony/console": "^8.1.11",
                    "symfony/process": "^8.1.10"
                },
                "suggest": {
                    "ext-pcntl": "Lets verify stop its commands, and what they started, on Ctrl-C"
                },
                "time": "2026-11-12T16:58:52+00:00",
                "default-branch": true,
                "type": "composer-plugin",
                "extra": {
                    "bluenostrum": {
                        "captainhook": {
                            "watch": [
                                "captainhook.json",
                                "captainhook.dev.json"
                            ]
                        },
                        "dependency-analyser": {
                            "ignore": [
                                {
                                    "errors": [
                                        "unused-dependency"
                                    ],
                                    "packages": [
                                        "ramsey/conventional-commits"
                                    ],
                                    "reason": "captainhook.json names its commit-msg validator; no PHP code does."
                                },
                                {
                                    "errors": [
                                        "shadow-dependency"
                                    ],
                                    "extensions": [
                                        "ext-pcntl"
                                    ],
                                    "reason": "Optional: verify traps signals only where function_exists('pcntl_signal'), and the tests that need it require it."
                                }
                            ]
                        },
                        "phpunit": {
                            "source": [
                                "bin/hook-block-self-credit"
                            ]
                        },
                        "plugin": {
                            "settings": "captainhook"
                        }
                    },
                    "captainhook": {
                        "config": "captainhook.dev.json"
                    },
                    "class": "Bluenostrum\\CaptainHook\\Composer\\Plugin"
                },
                "autoload": {
                    "psr-4": {
                        "Bluenostrum\\CaptainHook\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Bluenostrum\\CaptainHook\\Tests\\": "tests/"
                    }
                },
                "license": [
                    "proprietary"
                ],
                "authors": [
                    {
                        "name": "Antonio del Olmo",
                        "email": "adelolmo@bluenostrum.com"
                    }
                ],
                "description": "Shared git hooks and the check, ci, pre-commit and pre-push pipelines for bluenostrum repositories, as Composer commands",
                "support": {
                    "source": "https://github.com/bluenostrum/plugin-captainhook/tree/main",
                    "issues": "https://github.com/bluenostrum/plugin-captainhook/issues"
                }
            }
        ]
    }
}
