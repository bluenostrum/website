{
    "packages": {
        "bluenostrum/plugin-phpunit": [
            {
                "name": "bluenostrum/plugin-phpunit",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "git@github.com:bluenostrum/plugin-phpunit.git",
                    "reference": "a975bca8dbe5326772c99d3d767766f993c5beda"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/bluenostrum/plugin-phpunit/zipball/a975bca8dbe5326772c99d3d767766f993c5beda",
                    "reference": "a975bca8dbe5326772c99d3d767766f993c5beda",
                    "shasum": ""
                },
                "require": {
                    "bluenostrum/plugin-composer": "^1.0",
                    "composer-plugin-api": "^2.6",
                    "ext-dom": "*",
                    "php": "^8.5.12",
                    "phpunit/phpunit": "^13.4.6"
                },
                "require-dev": {
                    "bluenostrum/plugin-captainhook": "^2.0",
                    "bluenostrum/plugin-dependency-analyser": "^2.1",
                    "bluenostrum/plugin-infection": "^2.0",
                    "bluenostrum/plugin-phpcs": "^2.0",
                    "bluenostrum/plugin-phpstan": "^2.0",
                    "bluenostrum/plugin-psalm": "^1.0",
                    "bluenostrum/plugin-rector": "^2.0",
                    "composer/composer": "^2.10",
                    "php-parallel-lint/php-parallel-lint": "^1.4",
                    "roave/security-advisories": "dev-latest",
                    "symfony/process": "^8.1"
                },
                "time": "2026-11-04T18:05:20+00:00",
                "default-branch": true,
                "type": "composer-plugin",
                "extra": {
                    "bluenostrum": {
                        "captainhook": {
                            "verify": [
                                "composer phpunit"
                            ]
                        },
                        "dependency-analyser": {
                            "ignore": [
                                {
                                    "errors": [
                                        "prod-dependency-only-in-dev"
                                    ],
                                    "packages": [
                                        "phpunit/phpunit"
                                    ],
                                    "reason": "The commands run PHPUnit as an executable, so no production code names its classes; the package requires it so a project gets PHPUnit from the package alone."
                                }
                            ]
                        },
                        "plugin": {
                            "settings": "phpunit",
                            "verify": [
                                "phpunit"
                            ]
                        }
                    },
                    "captainhook": {
                        "config": "vendor/bluenostrum/plugin-captainhook/captainhook.json",
                        "force-install": true
                    },
                    "class": "Bluenostrum\\PhpUnit\\Composer\\Plugin"
                },
                "autoload": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "coverage": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php coverage"
                    ],
                    "phpunit": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php phpunit"
                    ]
                },
                "license": [
                    "proprietary"
                ],
                "authors": [
                    {
                        "name": "Antonio del Olmo",
                        "email": "adelolmo@bluenostrum.com"
                    }
                ],
                "description": "The composer phpunit and coverage commands, running PHPUnit on the configuration every bluenostrum repository shares",
                "support": {
                    "source": "https://github.com/bluenostrum/plugin-phpunit/tree/main",
                    "issues": "https://github.com/bluenostrum/plugin-phpunit/issues"
                }
            }
        ]
    }
}
