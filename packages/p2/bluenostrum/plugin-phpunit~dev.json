{
    "packages": {
        "bluenostrum/plugin-phpunit": [
            {
                "name": "bluenostrum/plugin-phpunit",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "git@github.com:bluenostrum/plugin-phpunit.git",
                    "reference": "ae57090a4aedf841a5f7a32da08459a0916db01b"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/bluenostrum/plugin-phpunit/zipball/ae57090a4aedf841a5f7a32da08459a0916db01b",
                    "reference": "ae57090a4aedf841a5f7a32da08459a0916db01b",
                    "shasum": ""
                },
                "require": {
                    "bluenostrum/plugin-composer": "^1.1.0",
                    "composer-plugin-api": "^2.6",
                    "ext-dom": "*",
                    "ext-libxml": "*",
                    "php": "^8.5.12",
                    "phpunit/phpunit": "^13.4.6"
                },
                "require-dev": {
                    "bluenostrum/plugin-captainhook": "^2.3.1",
                    "bluenostrum/plugin-dependency-analyser": "^2.2.1",
                    "bluenostrum/plugin-infection": "^2.0.1",
                    "bluenostrum/plugin-phpcs": "^2.1.2",
                    "bluenostrum/plugin-phpstan": "^2.5.1",
                    "bluenostrum/plugin-psalm": "^1.1.2",
                    "bluenostrum/plugin-rector": "^2.2.1",
                    "composer/composer": "^2.11.2",
                    "php-parallel-lint/php-parallel-lint": "^1.4",
                    "roave/security-advisories": "dev-latest",
                    "symfony/console": "^8.1.11"
                },
                "time": "2026-11-12T16:58:09+00:00",
                "default-branch": true,
                "type": "composer-plugin",
                "extra": {
                    "bluenostrum": {
                        "captainhook": {
                            "ci": [
                                "composer coverage"
                            ],
                            "verify": [
                                "composer phpunit"
                            ]
                        },
                        "dependency-analyser": {
                            "ignore": [
                                {
                                    "errors": [
                                        "prod-dependency-only-in-dev"
                                    ],
                                    "packages": [
                                        "phpunit/phpunit"
                                    ],
                                    "reason": "The commands run PHPUnit as an executable, so no production code names its classes; the package requires it so a project gets PHPUnit from the package alone."
                                }
                            ]
                        },
                        "plugin": {
                            "ci": [
                                "coverage"
                            ],
                            "settings": "phpunit",
                            "verify": [
                                "phpunit"
                            ]
                        }
                    },
                    "captainhook": {
                        "config": "vendor/bluenostrum/plugin-captainhook/captainhook.json",
                        "force-install": true
                    },
                    "class": "Bluenostrum\\PhpUnit\\Composer\\Plugin"
                },
                "autoload": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Bluenostrum\\PhpUnit\\Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "coverage": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php coverage"
                    ],
                    "phpunit": [
                        "@putenv XDEBUG_MODE=off",
                        "@php tests/Composer/run.php phpunit"
                    ]
                },
                "license": [
                    "proprietary"
                ],
                "authors": [
                    {
                        "name": "Antonio del Olmo",
                        "email": "adelolmo@bluenostrum.com"
                    }
                ],
                "description": "The composer phpunit and coverage commands, running PHPUnit on the configuration every bluenostrum repository shares",
                "support": {
                    "source": "https://github.com/bluenostrum/plugin-phpunit/tree/main",
                    "issues": "https://github.com/bluenostrum/plugin-phpunit/issues"
                }
            }
        ]
    }
}
