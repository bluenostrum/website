                                                "Psr\\Clock"
                                            ],
                                            "RateLimiter": [
                                                "Psr\\Log"
                                            ],
                                            "Schedule": [
                                                "Cron",
                                                "Psr\\Clock"
                                            ],
                                            "Tenancy": [],
                                            "Uuid": []
                                        },
                                        "alwaysAllowed": [
                                            "Ramsey\\Uuid",
                                            "Webmozart\\Assert"
                                        ],
                                        "rootNamespace": "Bluenostrum"
                                    },
                                    "class": "Bluenostrum\\PhpStan\\Rule\\VendorBoundaryRule"
                                }
                            ],
                            "stubFiles": [
                                "resources/stubs/symfony.php"
                            ]
                        },
                        "psalm": {
                            "stubs": [
                                "resources/stubs/symfony.php"
                            ],
                            "suppress": [
                                {
                                    "issue": "ImmutableDependency",
                                    "paths": [
                                        "src/Bridge/Valinor/Cqrs/HydrationFailed.php",
                                        "src/Bridge/Valinor/Cqrs/RefusedArgument.php"
                                    ],
                                    "reason": "Valinor marks MappingError::messages/type/source, Message::body and HasParameters::parameters @pure, which under Psalm 7 no implementation returning stored state can satisfy; CuyZ/Valinor#854 fixes it, and #472 tracks removing this."
                                }
                            ]
                        },
                        "rector": {
                            "skip": [
                                {
                                    "paths": [
                                        "tests/Bridge/Symfony/Outbox/Console/Mock/StopOnIdleWorkerListener.php"
                                    ],
                                    "reason": "The listener is registered by subscription on purpose, to test that path.",
                                    "rules": [
                                        "Rector\\Symfony\\CodeQuality\\Rector\\Class_\\EventSubscriberToAttributeRector"
                                    ]
                                },
                                {
                                    "paths": [
                                        "src/Domain/EventRecordingAggregateRoot.php"
                                    ],
                                    "reason": "The promoted id must stay writable for Doctrine hydration.",
                                    "rules": [
                                        "Rector\\Php81\\Rector\\Property\\ReadOnlyPropertyRector"
                                    ]
                                }
                            ]
                        }
                    },
                    "captainhook": {
                        "config": "vendor/bluenostrum/plugin-captainhook/captainhook.json",
                        "force-install": true
                    },
                    "phpstan": {
                        "includes": [
