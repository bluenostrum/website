                                        },
                                        "rootNamespace": "Bluenostrum"
                                    },
                                    "class": "Bluenostrum\\PhpStan\\Rule\\ModuleBoundaryRule"
                                },
                                {
                                    "arguments": {
                                        "allowedDependencies": {
                                            "Doctrine": [],
                                            "Monolog": [],
                                            "Symfony": [
                                                "Doctrine",
                                                "Monolog",
                                                "Valinor"
                                            ],
                                            "Valinor": []
                                        },
                                        "rootNamespace": "Bluenostrum\\Bridge"
                                    },
                                    "class": "Bluenostrum\\PhpStan\\Rule\\ModuleBoundaryRule"
                                },
                                {
                                    "arguments": {
                                        "excludePatterns": [
                                            "#\\\\Tests\\\\#"
                                        ],
                                        "patterns": [
                                            "#^Bluenostrum\\\\#"
                                        ]
