                    "phpstan/phpstan": "^2.3",
                    "roave/security-advisories": "dev-latest",
                    "symfony/process": "^8.1"
                },
                "suggest": {
                    "bluenostrum/plugin-phpstan": "Required to load extension.neon (the framework's PHPStan rules extend it); private repository, served by the https://bluenostrum.com/packages Composer registry",
                    "phpstan/phpstan": "Required to use the PHPStan rules in extension.neon"
                },
                "time": "2026-11-12T15:30:58+00:00",
                "default-branch": true,
                "bin": [
                    "bin/bluenostrum"
                ],
                "type": "library",
                "extra": {
                    "bluenostrum": {
                        "captainhook": {
                            "ci": [
                                "composer phpunit --fail-on-skipped"
                            ],
                            "pre-push": [
                                "bin/check-against-postgres"
                            ],
                            "watch": [
                                "compose.yaml"
                            ]
                        },
                        "dependency-analyser": {
                            "ignore": [
                                {
                                    "errors": [
                                        "dev-dependency-in-prod"
                                    ],
                                    "packages": [
                                        "phpstan/phpstan"
                                    ],
                                    "paths": [
                                        "src/PhpStan"
                                    ],
                                    "reason": "The PhpStan component ships rules consumers load through PHPStan itself, so it references PHPStan classes without requiring the package in production."
                                }
                            ]
                        },
                        "exclude": [
                            {
                                "paths": [
                                    "tests/PhpStan/Fixture"
                                ],
                                "reason": "The PHPStan rule fixtures break the rules and miscase class names on purpose, to give the rules something to report."
                            }
                        ],
                        "phpcs": {
                            "exclude": [
                                {
                                    "paths": [
                                        "src/Http/Routing/HttpMethod.php",
                                        "src/Domain/ValueObject/NamingConvention.php",
                                        "src/Cqrs/FilterOperator.php",
                                        "src/Bridge/Doctrine/Cqrs/SqlOperator.php"
                                    ],
                                    "reason": "Their string values are externally defined and cannot be snake_case: HTTP method tokens (RFC 7231), the public names of the naming conventions themselves, and SQL and filter comparison operator symbols.",
                                    "sniffs": [
                                        "Bluenostrum.Enums.EnumValueSnakeCase"
                                    ]
                                }
                            ]
                        },
                        "phpstan": {
                            "ignoreErrors": [
                                {
                                    "identifier": "bluenostrum.attribute.target",
                                    "paths": [
                                        "tests/Mcp/Fixture/TaggedWrite.php",
                                        "tests/Mcp/Fixture/TaggedBareRequest.php"
                                    ],
                                    "reason": "The tool catalog tests need #[McpTool] on messages it must leave out."
                                }
                            ],
                            "includes": [
                                "extension.neon"
                            ],
                            "rules": [
                                "Bluenostrum\\PhpStan\\Rule\\AssertMessageEscapingRule",
                                "Bluenostrum\\PhpStan\\Rule\\ExceptionMessageSanitizingRule"
                            ],
                            "services": [
                                {
                                    "arguments": {
                                        "excludePatterns": [
                                            "#\\\\Tests\\\\#"
                                        ],
                                        "patterns": [
                                            "#^Bluenostrum\\\\#"
                                        ]
                                    },
                                    "class": "Bluenostrum\\PhpStan\\Rule\\JsonEncoderUsageRule"
                                },
                                {
                                    "arguments": {
                                        "allowedDependencies": {
                                            "Attribute": [],
                                            "Auth": [
                                                "Attribute",
                                                "Context",
                                                "Cqrs",
                                                "Exception"
                                            ],
                                            "Bridge": [
                                                "Attribute",
                                                "Auth",
                                                "Checkpoint",
                                                "Clock",
