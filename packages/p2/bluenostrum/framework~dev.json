                                            ],
                                            "OpenApi": [
                                                "Attribute",
                                                "Auth",
                                                "Context",
                                                "Cqrs",
                                                "Http",
                                                "RateLimiter"
                                            ],
                                            "Outbox": [
                                                "Clock",
                                                "Context",
                                                "Exception"
                                            ],
                                            "PhpStan": [
                                                "Auth",
                                                "Clock",
                                                "Cqrs",
                                                "Domain",
                                                "Exception",
                                                "Uuid"
                                            ],
                                            "RateLimiter": [
                                                "Attribute",
